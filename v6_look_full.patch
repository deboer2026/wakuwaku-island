 }
+
+/* ════════════════════════════════════════════════════
+   v6 外観完全適用: 背景トーン・光線・島ステージ・きがえボタン
+════════════════════════════════════════════════════ */
+
+/* ── 背景をプロト準拠のグラデーションに ── */
+.tp-wrap {
+  background: linear-gradient(180deg,
+    #4FB4F0 0%,
+    #8ED4FF 34%,
+    #DFF3FF 55%,
+    #FFF2D6 74%,
+    #FFFDF6 100%) !important;
+}
+
+/* ── ヒーロー背後の回転光線 ── */
+.ksk-title-zone::before {
+  content: "";
+  position: absolute;
+  top: -320px;
+  left: 50%;
+  width: 900px;
+  height: 900px;
+  transform: translateX(-50%);
+  z-index: -1;
+  pointer-events: none;
+  border-radius: 50%;
+  background: conic-gradient(from 0deg,
+    rgba(255,255,255,0.13) 0 10deg,  transparent 10deg 24deg,
+    rgba(255,255,255,0.13) 24deg 34deg, transparent 34deg 48deg,
+    rgba(255,255,255,0.13) 48deg 58deg, transparent 58deg 72deg,
+    rgba(255,255,255,0.13) 72deg 82deg, transparent 82deg 96deg,
+    rgba(255,255,255,0.13) 96deg 106deg, transparent 106deg 360deg);
+  animation: tp-rays-spin 60s linear infinite;
+}
+@keyframes tp-rays-spin {
+  to { transform: translateX(-50%) rotate(360deg); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .ksk-title-zone::before { animation: none; }
+}
+
+/* ── 島ステージ ── */
+.tp-island-stage {
+  position: relative;
+  width: min(560px, 96%);
+  margin: 10px auto 0;
+  animation: tp-island-bob 4s ease-in-out infinite;
+}
+@media (prefers-reduced-motion: reduce) {
+  .tp-island-stage { animation: none; }
+}
+@keyframes tp-island-bob {
+  0%, 100% { transform: translateY(0); }
+  50%      { transform: translateY(-6px); }
+}
+.tp-island-svg {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+/* キャラを島の上(しろの左右)へ。アンカーは .tp-island-stage */
+.tp-island-stage .ksk-chara-wrap--left {
+  left: auto;
+  right: calc(50% + min(84px, 17vw));
+  bottom: 8%;
+}
+.tp-island-stage .ksk-chara-wrap--right {
+  right: auto;
+  left: calc(50% + min(84px, 17vw));
+  bottom: 8%;
+}
+
+/* キャラ移設に伴い、旧・重なり回避の余白(735ced4)は不要になったため戻す */
+.tp-wrap .tp-hero-chips {
+  padding-left: 12px;
+  padding-right: 12px;
+}
+/* タイトル横のキャラ用余白も不要 */
+.tp-header .ksk-title-zone { padding-bottom: 14px; }
+
+/* ── きがえボタン ── */
+.tp-dress-btn {
+  border: none;
+  cursor: pointer;
+  font-family: inherit;
+  font-weight: 900;
+  font-size: 14px;
+  color: #7A2E52;
+  margin-top: 8px;
+  padding: 10px 26px;
+  border-radius: 999px;
+  background: linear-gradient(180deg, #FFC3D9, #FF8FB6 60%, #F26D9C);
+  box-shadow: 0 4px 0 #C4487A, 0 10px 18px rgba(242, 109, 156, 0.4), inset 0 2px 0 #FFE3EE;
+  transition: transform 0.12s, box-shadow 0.12s;
+}
+.tp-dress-btn:hover,
+.tp-dress-btn:active {
+  transform: translateY(2px);
+  box-shadow: 0 2px 0 #C4487A, 0 6px 12px rgba(242, 109, 156, 0.4), inset 0 2px 0 #FFE3EE;
+}
