+const report = { generatedAt: new Date().toISOString(), summary, errors, warnings, games };
+await mkdir(rel('reports'), { recursive: true });
+await writeFile(rel('reports', 'game-audit.json'), `${JSON.stringify(report, null, 2)}\n`, 'utf8');
