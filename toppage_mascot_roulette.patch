 /* ── トップ：GAME PARKバッジとタイトルの被り解消 ── */
 .tp-park-badge { margin-bottom: 14px !important; }
+
+/* ════════════════════════════════════
+   マスコット吹き出し
+════════════════════════════════════ */
+.tp-mascot-bubble {
+  position: relative;
+  display: inline-block;
+  max-width: 260px;
+  margin: 0 auto 6px;
+  padding: 7px 14px;
+  background: #fff;
+  border: 3px solid #ffb3c8;
+  border-radius: 18px;
+  font-family: 'M PLUS Rounded 1c', sans-serif;
+  font-weight: 800;
+  font-size: 13px;
+  color: #d14a76;
+  box-shadow: 0 3px 0 rgba(209,74,118,.18);
+  animation: tp-bubble-in .35s cubic-bezier(.34,1.56,.64,1);
+  z-index: 2;
+}
+.tp-mascot-bubble::after {
+  content: '';
+  position: absolute;
+  bottom: -9px;
+  left: 50%;
+  transform: translateX(-50%);
+  border: 7px solid transparent;
+  border-top-color: #ffb3c8;
+  border-bottom: 0;
+}
+@keyframes tp-bubble-in {
+  0%   { transform: scale(.6); opacity: 0; }
+  100% { transform: scale(1);  opacity: 1; }
+}
+.tp-hero-chars--bounce {
+  animation: tp-chars-bounce .55s cubic-bezier(.34,1.56,.64,1);
+}
+@keyframes tp-chars-bounce {
+  0%   { transform: translateY(0)    scale(1); }
+  30%  { transform: translateY(-14px) scale(1.06); }
+  55%  { transform: translateY(0)    scale(.97); }
+  75%  { transform: translateY(-5px) scale(1.02); }
+  100% { transform: translateY(0)    scale(1); }
+}
+
+/* ════════════════════════════════════
+   ゲームルーレット
+════════════════════════════════════ */
+.tp-roulette-btn {
+  display: block;
+  margin: 10px auto 14px;
+  padding: 12px 22px;
+  border: none;
+  border-radius: 999px;
+  background: linear-gradient(135deg, #ff8ab0, #ff5d8f);
+  color: #fff;
+  font-family: 'DotGothic16', 'M PLUS Rounded 1c', sans-serif;
+  font-size: 15px;
+  font-weight: 800;
+  cursor: pointer;
+  box-shadow: 0 4px 0 #d13a6c, 0 8px 16px rgba(255,93,143,.35);
+  animation: tp-roulette-pulse 2.2s ease-in-out infinite;
+  transition: transform .12s;
+}
+.tp-roulette-btn:active {
+  transform: translateY(3px);
+  box-shadow: 0 1px 0 #d13a6c;
+}
+@keyframes tp-roulette-pulse {
+  0%, 100% { transform: scale(1); }
+  50%      { transform: scale(1.04); }
+}
+.tp-roulette-overlay {
+  position: fixed;
+  inset: 0;
+  z-index: 1200;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: rgba(30, 10, 40, .55);
+  backdrop-filter: blur(3px);
+  animation: tp-bubble-in .25s ease-out;
+}
+.tp-roulette-box {
+  width: min(86vw, 340px);
+  padding: 20px 18px 18px;
+  background: linear-gradient(160deg, #fff7fb, #ffe9f2);
+  border: 4px solid #ffb3c8;
+  border-radius: 26px;
+  text-align: center;
+  box-shadow: 0 12px 40px rgba(0,0,0,.3);
+}
+.tp-roulette-title {
+  font-family: 'DotGothic16', sans-serif;
+  font-size: 17px;
+  font-weight: 800;
+  color: #d14a76;
+  margin-bottom: 12px;
+}
+.tp-roulette-card {
+  width: 200px;
+  margin: 0 auto;
+  border-radius: 20px;
+  padding: 12px 12px 14px;
+  border: 3px solid rgba(255,255,255,.7);
+  box-shadow: 0 6px 18px rgba(0,0,0,.22);
+}
+.tp-roulette-card--spin { animation: tp-roulette-shake .12s linear infinite; }
+.tp-roulette-card--win  { animation: tp-roulette-win .5s cubic-bezier(.34,1.56,.64,1); }
+@keyframes tp-roulette-shake {
+  0%   { transform: rotate(-2deg) scale(.98); }
+  50%  { transform: rotate(2deg)  scale(1.02); }
+  100% { transform: rotate(-2deg) scale(.98); }
+}
+@keyframes tp-roulette-win {
+  0%   { transform: scale(.85); }
+  60%  { transform: scale(1.1); }
+  100% { transform: scale(1); }
+}
+.tp-roulette-art { width: 100%; border-radius: 12px; overflow: hidden; background: rgba(255,255,255,.15); }
+.tp-roulette-art svg { display: block; width: 100%; height: auto; }
+.tp-roulette-icon { font-size: 56px; line-height: 85px; display: block; }
+.tp-roulette-name {
+  margin-top: 8px;
+  font-family: 'M PLUS Rounded 1c', sans-serif;
+  font-weight: 800;
+  font-size: 15px;
+  color: #fff;
+  text-shadow: 0 2px 3px rgba(0,0,0,.35);
+}
+.tp-roulette-actions {
+  margin-top: 14px;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  align-items: center;
+}
+.tp-roulette-play {
+  width: 100%;
+  padding: 12px;
+  border: none;
+  border-radius: 14px;
+  background: linear-gradient(135deg, #5bd68a, #2eab5e);
+  color: #fff;
+  font-family: 'DotGothic16', sans-serif;
+  font-size: 16px;
+  font-weight: 800;
+  cursor: pointer;
+  box-shadow: 0 4px 0 #1f7d43;
+}
+.tp-roulette-play:active { transform: translateY(3px); box-shadow: 0 1px 0 #1f7d43; }
+.tp-roulette-retry {
+  padding: 8px 18px;
+  border: 2px solid #ffb3c8;
+  border-radius: 999px;
+  background: #fff;
+  color: #d14a76;
+  font-family: 'M PLUS Rounded 1c', sans-serif;
+  font-weight: 800;
+  font-size: 13px;
+  cursor: pointer;
+}
+.tp-roulette-close {
+  margin-top: 2px;
+  border: none;
+  background: none;
+  color: #c98aa3;
+  font-size: 14px;
+  cursor: pointer;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tp-mascot-bubble,
+  .tp-hero-chars--bounce,
+  .tp-roulette-btn,
+  .tp-roulette-card--spin,
+  .tp-roulette-card--win { animation: none; }
+}
