diff --git a/src/pages/TopPage.css b/src/pages/TopPage.css
index 8e75099..a432fa5 100644
--- a/src/pages/TopPage.css
+++ b/src/pages/TopPage.css
@@ -1438,3 +1438,52 @@
 @media (prefers-reduced-motion: reduce) {
   .tp-card:active, .tp-zukan-cell--got { animation: none; }
 }
+
+/* ══════════════════════════════════════════════════════════
+   ✨ v1.4 VISUAL HIERARCHY — 押せる/押せないを明確に
+══════════════════════════════════════════════════════════ */
+
+/* ── ① タブをセグメントコントロール化(1つの枠で切替とわかる形) ── */
+.tp-tabs {
+  gap: 0;
+  padding: 4px;
+  margin: 0 auto 4px;
+  width: fit-content;
+  background: rgba(255,255,255,.75);
+  border: 2px solid rgba(0,0,0,.08);
+  border-radius: 999px;
+  box-shadow: inset 0 2px 4px rgba(0,0,0,.08);
+}
+.tp-tab {
+  border: none;
+  background: transparent;
+  box-shadow: none;
+  padding: 9px 20px;
+  transform: none;
+  color: #7a8aa0;
+}
+.tp-tab--active {
+  background: linear-gradient(135deg,#4DB8FF,#2a7fd4);
+  color: #fff;
+  border: none;
+  transform: none;
+  box-shadow: 0 2px 6px rgba(42,127,212,.4);
+}
+
+/* ── ② 飾りはフラットに(影・立体感を消して「押せない」と示す) ── */
+.tp-season {
+  background: rgba(255,255,255,.5);
+  border-width: 1.5px;
+  box-shadow: none;
+  padding: 6px 18px;
+  font-size: 13px;
+}
+.tp-mascot-bubble {
+  box-shadow: none;
+  border-width: 2px;
+}
+
+/* ── ③ ボタンだけ立体感を強調 ── */
+.tp-action-row { margin-top: 12px; }
+.tp-action-row .tp-roulette-btn,
+.tp-zukan-btn { font-size: 14px; }
