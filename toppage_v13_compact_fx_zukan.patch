+/* ══════════════════════════════════════════════════════════
+   ✨ v1.3 COMPACT LAYOUT + CARD FX + STAMP ZUKAN
+══════════════════════════════════════════════════════════ */
+
+/* ── ① ヒーローさらに圧縮(ゲームを早く見せる) ── */
+.tp-header {
+  padding-top: max(46px, calc(env(safe-area-inset-top, 0px) + 42px));
+}
+.tp-title-1 { font-size: clamp(36px, 10vw, 60px); }
+.tp-title-2 { font-size: clamp(26px, 7.5vw, 44px); }
+.tp-header .ksk-title-zone { padding-bottom: 20px; }
+.tp-subtitle { padding: 4px 16px; font-size: 12.5px; }
+.tp-mascot-bubble { font-size: 12px; padding: 6px 12px; margin-bottom: 4px; }
+.tp-hero-row { margin-top: 2px; }
+
+/* ── ② グリッド密度アップ ── */
