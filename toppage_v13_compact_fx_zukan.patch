+.tp-card-body { padding: 9px 10px 10px; }
+.tp-card-desc { font-size: 11.5px; line-height: 1.3; }
+
+/* ── ③ カードタップ演出(モバイル) ── */
+.tp-card {
+  transition: transform .12s cubic-bezier(.34,1.56,.64,1), filter .12s;
+}
+.tp-card:active {
+  transform: scale(.94) rotate(-1deg) !important;
+  filter: brightness(1.12) saturate(1.15);
+}
+.tp-card:active::after {
+  animation: cardGloss 0.5s ease forwards;
+}
+.tp-recent-card { transition: transform .12s cubic-bezier(.34,1.56,.64,1); }
+.tp-recent-card:active { transform: scale(.92); }
+
+/* ── ④ アクションボタン行 ── */
+.tp-action-row {
+  display: flex;
+  gap: 8px;
+  justify-content: center;
+  align-items: stretch;
+  margin: 10px auto 14px;
+  flex-wrap: wrap;
+}
+.tp-action-row .tp-roulette-btn { margin: 0; flex: 1 1 auto; max-width: 220px; font-size: 13.5px; padding: 11px 14px; }
+.tp-zukan-btn {
+  flex: 1 1 auto;
+  max-width: 200px;
+  padding: 11px 14px;
+  border: none;
+  border-radius: 999px;
+  background: linear-gradient(135deg, #8f7bff, #6a4fe0);
+  color: #fff;
+  font-family: 'DotGothic16', 'M PLUS Rounded 1c', sans-serif;
+  font-size: 13.5px;
+  font-weight: 800;
+  cursor: pointer;
+  box-shadow: 0 4px 0 #4c37ad, 0 8px 16px rgba(106,79,224,.3);
+  transition: transform .12s;
+}
+.tp-zukan-btn:active { transform: translateY(3px); box-shadow: 0 1px 0 #4c37ad; }
+
+/* ── ⑤ スタンプずかん ── */
+.tp-zukan-box {
+  width: min(92vw, 400px);
+  max-height: 82vh;
+  overflow-y: auto;
+  padding: 18px 14px 14px;
+  background: linear-gradient(160deg, #fdf9ff, #efe8ff);
+  border: 4px solid #b9a5ff;
+  border-radius: 26px;
+  text-align: center;
+  box-shadow: 0 12px 40px rgba(0,0,0,.3);
+}
+.tp-zukan-box .tp-roulette-title { color: #6a4fe0; }
+.tp-zukan-progress {
+  font-family: 'DotGothic16', sans-serif;
+  font-size: 15px;
+  font-weight: 800;
+  color: #8a6fe8;
+  margin-bottom: 12px;
+}
+.tp-zukan-grid {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 8px;
+}
+.tp-zukan-cell {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 3px;
+  padding: 8px 2px 6px;
+  border: 2px dashed #cbbcf5;
+  border-radius: 14px;
+  background: #f3eefc;
+  cursor: pointer;
+  transition: transform .12s;
+}
+.tp-zukan-cell:active { transform: scale(.9); }
+.tp-zukan-cell--got {
+  border: 2px solid rgba(255,255,255,.75);
+  box-shadow: 0 3px 8px rgba(0,0,0,.18);
+  animation: tp-roulette-win .4s cubic-bezier(.34,1.56,.64,1);
+}
+.tp-zukan-icon { font-size: 26px; line-height: 1; }
+.tp-zukan-cell:not(.tp-zukan-cell--got) .tp-zukan-icon { opacity: .45; }
+.tp-zukan-name {
+  font-family: 'M PLUS Rounded 1c', sans-serif;
+  font-weight: 800;
+  font-size: 8.5px;
+  line-height: 1.15;
+  color: #9a8bc4;
+  word-break: keep-all;
+  overflow-wrap: anywhere;
+}
+.tp-zukan-cell--got .tp-zukan-name { color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,.4); }
+.tp-zukan-hint {
+  margin: 12px 0 6px;
+  font-family: 'M PLUS Rounded 1c', sans-serif;
+  font-weight: 700;
+  font-size: 12px;
+  color: #8a6fe8;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tp-card:active, .tp-zukan-cell--got { animation: none; }
+}
