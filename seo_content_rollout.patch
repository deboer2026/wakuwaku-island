diff --git a/src/hooks/useGameNav.js b/src/hooks/useGameNav.js
new file mode 100644
index 0000000..d2f98b3
--- /dev/null
+++ b/src/hooks/useGameNav.js
@@ -0,0 +1,16 @@
+import { useEffect } from 'react';
+
+export function useGameNav(navigate) {
+  useEffect(() => {
+    const handler = (e) => {
+      if (e.data?.type === 'goHome') { navigate('/'); return; }
+      if (e.data?.type === 'goBack') {
+        let internal = false;
+        try { internal = sessionStorage.getItem('ww_nav_internal') === '1'; } catch {}
+        navigate(internal ? -1 : '/');
+      }
+    };
+    window.addEventListener('message', handler);
+    return () => window.removeEventListener('message', handler);
+  }, [navigate]);
+}
