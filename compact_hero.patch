diff --git a/src/pages/TopPage.css b/src/pages/TopPage.css
index 42f1201..75be9c1 100644
--- a/src/pages/TopPage.css
+++ b/src/pages/TopPage.css
@@ -1754,3 +1754,110 @@
   box-shadow: 0 3px 0 rgba(0,0,0,0.15);
 }
 .tp-view-tab:active { transform: scale(0.96); }
+
+/* ══════════════════════════════════════════════════════════
+   ✨ v2.0 COMPACT HERO + STICKY NAV
+   （1画面目でしまマップの建物が見える構成へ圧縮）
+══════════════════════════════════════════════════════════ */
+
+/* ── ① ヒーロー大幅圧縮 ── */
+.tp-header {
+  padding-top: max(64px, calc(env(safe-area-inset-top, 0px) + 60px));
+  padding-bottom: 0;
+  gap: 2px;
+}
+.tp-title-wrap { animation: none !important; }
+.tp-title {
+  flex-direction: row;
+  align-items: baseline;
+  gap: 6px;
+  flex-wrap: wrap;
+  justify-content: center;
+}
+.tp-title-1 { font-size: clamp(26px, 8vw, 42px) !important; }
+.tp-title-2 { font-size: clamp(26px, 8vw, 42px) !important; }
+.tp-header .ksk-title-zone { padding-bottom: 4px; }
+
+/* キャラを小型化してタイトル1行と同じ高さ帯に */
+.tp-header .ksk-svg { width: 46px; height: 73px; }
+.tp-header .ksk-pet { font-size: 14px; }
+
+/* 吹き出しはコンパクトに */
+.tp-mascot-bubble {
+  font-size: 11px;
+  padding: 4px 10px;
+  margin-bottom: 2px;
+  max-width: 210px;
+}
+
+/* 季節チップ（タイトル直下・非ボタン装飾） */
+.tp-season--chip {
+  margin: 2px auto 0;
+  padding: 3px 12px !important;
+  font-size: 11.5px !important;
+  border-width: 1.5px !important;
+  animation: none !important;
+  background: rgba(255,255,255,0.55) !important;
+  box-shadow: none !important;
+}
+
+.tp-game-section { padding-top: 6px; }
+
+/* ── ② sticky統合バー（タブ＋エリアジャンプ） ── */
+.tp-sticky-bar {
+  position: sticky;
+  top: calc(env(safe-area-inset-top, 0px) + 6px);
+  z-index: 40;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin: 0 0 12px;
+  padding: 7px 8px;
+  background: rgba(228,244,255,0.88);
+  backdrop-filter: blur(8px);
+  -webkit-backdrop-filter: blur(8px);
+  border-radius: 22px;
+  box-shadow: 0 4px 14px rgba(0,0,0,0.12);
+}
+.tp-sticky-bar .tp-view-toggle {
+  margin: 0 auto;
+  padding: 4px;
+  max-width: 300px;
+  width: 100%;
+  background: rgba(255,255,255,0.5);
+  box-shadow: inset 0 2px 5px rgba(0,0,0,0.08);
+}
+.tp-sticky-bar .tp-view-tab {
+  padding: 7px 4px;
+  font-size: 13px;
+}
+.tp-sticky-jump {
+  display: flex;
+  gap: 6px;
+  overflow-x: auto;
+  padding: 1px 2px 3px;
+  -webkit-overflow-scrolling: touch;
+  scrollbar-width: none;
+}
+.tp-sticky-jump::-webkit-scrollbar { display: none; }
+.tp-sticky-jump .im-jump-btn {
+  font-size: 12px;
+  padding: 4px 11px;
+  border-width: 2.5px;
+}
+
+/* ── ③ 右上ボタン群：モバイルではショップをアイコン化 ── */
+@media (max-width: 560px) {
+  .tp-top-btns { gap: 5px; }
+  .tp-top-btn { width: 40px; height: 40px; font-size: 16px; }
+  .tp-shop-label { display: none; }
+  .tp-shop-btn {
+    width: 40px !important;
+    padding: 0 !important;
+    border-radius: 50% !important;
+    gap: 0;
+  }
+}
+
+/* ── ④ 最近遊んだ（マップ下配置に合わせ軽量化） ── */
+.tp-recent { margin-top: 16px; }
