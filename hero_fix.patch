diff --git a/src/pages/TopPage.css b/src/pages/TopPage.css
index 75be9c1..b2c6b10 100644
--- a/src/pages/TopPage.css
+++ b/src/pages/TopPage.css
@@ -1861,3 +1861,82 @@
 
 /* ── ④ 最近遊んだ（マップ下配置に合わせ軽量化） ── */
 .tp-recent { margin-top: 16px; }
+
+/* ══════════════════════════════════════════════════════════
+   ✨ v2.1 HERO FIX — 余白カット・キャラ被り解消・ゲーム感UP
+══════════════════════════════════════════════════════════ */
+
+/* ── ① 空白カット：既存の +30px !important を上書き ── */
+.tp-header {
+  padding-top: calc(var(--tp-topbar-h, 60px) + env(safe-area-inset-top, 0px) + 4px) !important;
+}
+@media (max-width: 560px) {
+  /* v2.0でボタンを40pxに縮小済み → 帯の高さも詰める */
+  .tp-header {
+    padding-top: calc(52px + env(safe-area-inset-top, 0px) + 4px) !important;
+  }
+}
+
+/* ── ② キャラ被り解消：タイトルにキャラ分の左右余白を確保 ── */
+.tp-header .tp-title-wrap {
+  padding: 0 58px;
+  box-sizing: border-box;
+  width: 100%;
+}
+.tp-title-1,
+.tp-title-2 {
+  font-size: clamp(21px, 6.2vw, 36px) !important;
+}
+/* タブレット以上でも被らないだけの余白 */
+@media (min-width: 480px) {
+  .tp-header .tp-title-wrap { padding: 0 100px; }
+}
+
+/* 吹き出し・チップ類の縦間隔を最小化 */
+.tp-header .ksk-title-zone { padding-bottom: 2px; }
+.tp-mascot-bubble { margin-bottom: 3px; }
+
+/* ── ③ チップ行：季節＋ゲーム数 ── */
+.tp-hero-chips {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  flex-wrap: wrap;
+  margin-top: 3px;
+}
+.tp-hero-chips .tp-season--chip { margin: 0; }
+
+.tp-count-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  background: linear-gradient(135deg, #FF6FA5, #FF4081);
+  border: 2px solid #fff;
+  border-radius: 30px;
+  padding: 3px 13px;
+  font-family: 'M PLUS Rounded 1c', sans-serif;
+  font-size: 12px;
+  font-weight: 900;
+  color: #fff;
+  box-shadow: 0 3px 0 rgba(180,30,80,0.35), 0 3px 10px rgba(255,64,129,0.35);
+  animation: tp-count-pop 2.6s ease-in-out infinite;
+  white-space: nowrap;
+}
+@keyframes tp-count-pop {
+  0%, 100% { transform: scale(1); }
+  50%      { transform: scale(1.05); }
+}
+
+/* ── ④ START旗をゲームっぽく跳ねさせる ── */
+.im-start {
+  animation: im-start-hop 1.4s ease-in-out infinite;
+}
+@keyframes im-start-hop {
+  0%, 100% { transform: translateX(-50%) translateY(0); }
+  50%      { transform: translateX(-50%) translateY(-6px); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tp-count-chip, .im-start { animation: none; }
+}
