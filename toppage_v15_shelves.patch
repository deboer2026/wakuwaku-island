@@ -1487,3 +1487,93 @@
 .tp-action-row { margin-top: 12px; }
 .tp-action-row .tp-roulette-btn,
 .tp-zukan-btn { font-size: 14px; }
+
+/* ══════════════════════════════════════════════════════════
+   ✨ v1.5 CATEGORY SHELVES — カテゴリ別横スクロール棚
+══════════════════════════════════════════════════════════ */
+.tp-shelf { margin: 4px 0 14px; }
+.tp-shelf-title {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 0 14px 8px;
+  font-family: 'M PLUS Rounded 1c', sans-serif;
+  font-weight: 800;
+  font-size: 15px;
+  color: #2d4a63;
+  text-align: left;
+}
+.tp-shelf-scroll {
+  display: flex;
+  gap: 10px;
+  overflow-x: auto;
+  padding: 2px 14px 10px;
+  scroll-snap-type: x proximity;
+  -webkit-overflow-scrolling: touch;
+  scrollbar-width: none;
+}
+.tp-shelf-scroll::-webkit-scrollbar { display: none; }
+.tp-shelf-card {
+  position: relative;
+  flex: 0 0 auto;
+  width: 128px;
+  scroll-snap-align: start;
+  border: 3px solid rgba(255,255,255,.65);
+  border-radius: 18px;
+  padding: 8px 8px 9px;
+  cursor: pointer;
+  box-shadow: 0 4px 10px rgba(0,0,0,.16);
+  transition: transform .12s cubic-bezier(.34,1.56,.64,1), filter .12s;
+  overflow: hidden;
+}
+.tp-shelf-card:active {
+  transform: scale(.93) rotate(-1deg);
+  filter: brightness(1.12) saturate(1.15);
+}
+.tp-shelf-art {
+  border-radius: 12px;
+  overflow: hidden;
+  background: rgba(255,255,255,.12);
+}
+.tp-shelf-art svg { display: block; width: 100%; height: auto; }
+.tp-shelf-icon-fb { font-size: 44px; line-height: 96px; display: block; }
+.tp-shelf-name {
+  margin-top: 6px;
+  font-family: 'M PLUS Rounded 1c', sans-serif;
+  font-weight: 800;
+  font-size: 12px;
+  line-height: 1.25;
+  color: #fff;
+  text-shadow: 0 2px 3px rgba(0,0,0,.35);
+  min-height: 2.5em;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+.tp-shelf-new {
+  position: absolute;
+  top: 6px;
+  right: 6px;
+  z-index: 2;
+  padding: 2px 7px;
+  border-radius: 999px;
+  background: #ff4d6d;
+  color: #fff;
+  font-size: 9px;
+  font-weight: 800;
+  font-family: 'M PLUS Rounded 1c', sans-serif;
+  box-shadow: 0 2px 4px rgba(0,0,0,.25);
+}
+.tp-shelf-hard {
+  position: absolute;
+  top: 5px;
+  left: 6px;
+  z-index: 2;
+  font-size: 14px;
+  filter: drop-shadow(0 1px 2px rgba(0,0,0,.3));
+}
+
+/* 棚導入に伴い旧グリッドは非表示状態のためエントランスアニメの負荷なし */
+@media (min-width: 700px) {
+  .tp-shelf-card { width: 148px; }
+}
