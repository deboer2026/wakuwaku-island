diff --git a/src/seo/GameContent.css b/src/seo/GameContent.css
index b861bd8..bc36e41 100644
--- a/src/seo/GameContent.css
+++ b/src/seo/GameContent.css
@@ -24,3 +24,55 @@
 .gc-related a { text-decoration: none; color: #5a4a52; background: #fff; border: 2px solid #f0e2ea; border-radius: 12px; padding: 10px 14px; font-weight: 700; font-size: 14px; box-shadow: 0 3px 0 #f0e2ea; display: inline-block; }
 .gc-back { text-align: center; margin-top: 22px; }
 .gc-back a { color: #a34767; font-weight: 700; text-decoration: none; }
+
+/* ── プレイ中スクロールロック ──
+   既定でページスクロールを止め、ゲームを固定全画面にする。
+   説明文は DOM/CSS 上そのまま残る（display:none にしない）ので SEO 影響なし。 */
+.wi-play-lock {
+  overflow: hidden !important;
+  overscroll-behavior: none;
+  touch-action: pan-x pan-y;
+}
+.wi-play-lock .game-frame {
+  position: fixed;
+  top: env(safe-area-inset-top, 0px);
+  left: 0; right: 0; bottom: 0;
+  width: 100%; height: auto;
+  z-index: 40;
+  overscroll-behavior: none;
+}
+
+/* せつめい ボタン（ホームチップの左どなり） */
+.wi-info-chip {
+  position: fixed; z-index: 60;
+  top: calc(env(safe-area-inset-top, 0px) + 10px);
+  right: calc(env(safe-area-inset-right, 0px) + 88px);
+  display: flex; align-items: center; gap: 5px;
+  background: rgba(255,255,255,.82);
+  -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
+  border: 2px solid rgba(255,255,255,.9); border-radius: 999px;
+  padding: 6px 11px 6px 9px;
+  font-family: 'DotGothic16', sans-serif; font-size: 12px; color: #a34767; font-weight: 700;
+  box-shadow: 0 2px 6px rgba(163,71,103,.18);
+  cursor: pointer;
+}
+.wi-info-chip:active { transform: scale(.94); }
+
+/* ゲームにもどる ボタン（説明を読んでいるとき） */
+.wi-resume-btn {
+  position: fixed; z-index: 60;
+  left: 50%; transform: translateX(-50%);
+  bottom: calc(env(safe-area-inset-bottom, 0px) + 14px);
+  display: flex; align-items: center; gap: 6px;
+  background: #4DB8FF; color: #fff;
+  border-radius: 999px; padding: 11px 22px;
+  font-family: 'DotGothic16', sans-serif; font-size: 14px; font-weight: 700;
+  box-shadow: 0 4px 12px rgba(77,184,255,.45);
+  cursor: pointer;
+}
+.wi-resume-btn:active { transform: translateX(-50%) scale(.95); }
+
+@media (prefers-reduced-motion: reduce) {
+  .wi-info-chip:active { transform: none; }
+  .wi-resume-btn:active { transform: translateX(-50%); }
+}
